# Production Environment Variables
# Copy this file to .env and fill in your values

# ─── Supabase Database ────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → Database → Connection string
#
# "Transaction" mode (port 6543) — used by the app at runtime via PgBouncer
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# "Session" mode (port 5432) — used by Prisma for migrations (direct connection)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="CHANGE_THIS_TO_SECURE_RANDOM_STRING"
JWT_EXPIRES_IN="24h"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV="production"

# ─── CORS ────────────────────────────────────────────────────────────────────
# Update with your frontend URL (e.g. your Vercel or Hostinger domain)
CORS_ORIGIN="https://your-frontend-url.com"

# ─── Cloudinary (Image uploads) ──────────────────────────────────────────────
# Get these from: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─── Paystack (Payment gateway) ──────────────────────────────────────────────
# Get these from: https://dashboard.paystack.com → Settings → API Keys
# Use sk_test_... / pk_test_... for test mode, sk_live_... / pk_live_... for production
PAYSTACK_SECRET_KEY="sk_test_REPLACE_WITH_YOUR_KEY"
PAYSTACK_PUBLIC_KEY="pk_test_REPLACE_WITH_YOUR_KEY"

