{
    "name": "kaysdrive-backend",
    "version": "1.0.0",
    "description": "Backend API for Kays Drive car dealership and store",
    "main": "dist/index.js",
    "scripts": {
        "dev": "nodemon src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "seed": "tsx prisma/seed.ts",
        "postinstall": "prisma generate",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:migrate:deploy": "prisma migrate deploy",
        "db:seed": "tsx prisma/seed.ts",
        "db:studio": "prisma studio"
    },
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    },
    "dependencies": {
        "@prisma/client": "^5.10.0",
        "bcryptjs": "^2.4.3",
        "cloudinary": "^2.10.0",
        "cors": "^2.8.6",
        "express": "^4.18.2",
        "express-rate-limit": "^8.6.2",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.2.0"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.2.0",
        "@types/node": "^20.11.0",
        "prisma": "^5.10.0",
        "tsx": "^4.23.12",
        "typescript": "^5.3.3"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    }
}
